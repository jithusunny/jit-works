<section class="work" id="work" data-section="selected-work">
  <div class="section-label"><h2>Selected projects</h2></div>
  <div class="project-list">
    <article
      class="project-panel feature"
      id="mridhu"
      data-section="mridhu-case"
      aria-labelledby="mridhu-title"
    >
      <div class="project-info reveal">
        <p class="eyebrow">COMMERCE</p>
        <h3 id="mridhu-title" class="project-identity identity-mridhu">
          <img
            src="/assets/portfolio/mridhu-logo.webp"
            alt="Mridhu by Elsa"
            class="identity-wordmark"
            width="672"
            height="318"
          />
        </h3>
        <p class="project-purpose">Online textile shop</p>
        <p class="project-detail">Products, checkout, orders and inventory.</p>
        <a class="text-link" href="https://mridhu.in" target="_blank" rel="noopener"
          >Visit Mridhu ↗</a
        >
      </div>
      <figure class="project-visual reveal shop-visual">
        <div class="shop-device-pair">
          <div class="laptop-device">
            <div class="laptop-display">
              <span class="device-camera" aria-hidden="true"></span
              ><img
                src="/assets/portfolio/previews/mridhu-rich.webp"
                alt="Mridhu bedsheet collection on a laptop"
                width="1200"
                height="800"
                loading="lazy"
              />
            </div>
            <div class="laptop-base" aria-hidden="true"></div>
          </div>
          <div class="phone-device">
            <span class="device-speaker" aria-hidden="true"></span
            ><img
              src="/assets/portfolio/previews/mridhu-product.webp"
              alt="Mridhu Blue Bloom product details on a phone"
              width="390"
              height="844"
              loading="lazy"
            />
          </div>
        </div>
      </figure>
    </article>
    <article
      class="project-panel"
      id="ribbonpage"
      data-section="ribbonpage-case"
      aria-labelledby="ribbonpage-title"
    >
      <div class="project-info reveal">
        <p class="eyebrow">DIGITAL PUBLISHING</p>
        <h3 id="ribbonpage-title">Ribbonpage</h3>
        <p class="project-purpose">PDF to online flipbook</p>
        <p class="project-detail">Menus, catalogues and brochures. A link to open and share.</p>
        <a
          class="text-link"
          href="https://ribbonpage.com/tonico-menu-demo"
          target="_blank"
          rel="noopener"
          >Open the Tonico menu ↗</a
        >
      </div>
      <div class="project-visual reveal book-visual">
        <div class="menu-tablet">
          <iframe
            class="tonico-book"
            data-src="/demos/menu/index.html?embedded=1"
            title="Turn the pages of the Tonico menu"
            loading="lazy"
            allow="fullscreen"
            sandbox="allow-scripts allow-same-origin allow-popups allow-popups-to-escape-sandbox"
          ></iframe>
        </div>
      </div>
    </article>
    <article
      class="project-panel"
      id="lifesuite"
      data-section="lifesuite-case"
      aria-labelledby="lifesuite-title"
    >
      <div class="project-info reveal">
        <p class="eyebrow">WEB + ANDROID</p>
        <h3 id="lifesuite-title" class="project-identity identity-lifesuite">
          <img
            src="/assets/portfolio/lifesuite-mark.svg"
            alt=""
            aria-hidden="true"
            class="identity-mark"
            width="64"
            height="64"
          /><span class="identity-name">LifeSuite</span>
        </h3>
        <p class="project-purpose">Personal life organiser</p>
        <p class="project-detail">
          A daily journal connected to people and places. Plus finances, shopping, meals, tasks and
          reminders.
        </p>
        <ul class="product-strengths" aria-label="LifeSuite privacy and sync">
          <li>End-to-end encrypted</li>
          <li>Local-first. Works offline.</li>
          <li>Syncs across your devices</li>
        </ul>
        <a class="text-link" href="https://lifesuite.jithusunny.com" target="_blank" rel="noopener"
          >Explore LifeSuite ↗</a
        >
      </div>
      <div class="project-visual reveal life-showcase">
        <div class="life-feature-tabs" role="tablist" aria-label="Explore LifeSuite">
          <button
            type="button"
            role="tab"
            id="life-tab-pulse"
            aria-selected="true"
            aria-controls="life-feature"
            data-life="pulse"
          >
            Pulse</button
          ><button
            type="button"
            role="tab"
            id="life-tab-people"
            aria-selected="false"
            tabindex="-1"
            aria-controls="life-feature"
            data-life="people"
          >
            People</button
          ><button
            type="button"
            role="tab"
            id="life-tab-places"
            aria-selected="false"
            tabindex="-1"
            aria-controls="life-feature"
            data-life="places"
          >
            Places</button
          ><button
            type="button"
            role="tab"
            id="life-tab-shopping"
            aria-selected="false"
            tabindex="-1"
            aria-controls="life-feature"
            data-life="shopping"
          >
            Shopping
          </button>
        </div>
        <div id="life-feature" role="tabpanel" aria-labelledby="life-tab-pulse" tabindex="0">
          <p class="life-feature-summary">
            Remember what happened, who was there and the details you wanted to keep.
          </p>
          <div class="life-device-pair">
            <a
              class="tablet-device"
              href="/assets/portfolio/life-pulse-tablet.webp"
              data-image="/assets/portfolio/life-pulse-tablet.webp"
              data-title="LifeSuite · Pulse"
              aria-label="Enlarge LifeSuite Pulse on a tablet"
              ><span class="device-camera" aria-hidden="true"></span
              ><img
                class="life-tablet-image"
                src="/assets/portfolio/previews/life-pulse-tablet.webp"
                alt="LifeSuite Pulse timeline on a tablet"
                width="1024"
                height="768"
                loading="lazy" /></a
            ><a
              class="phone-device"
              href="/assets/portfolio/life-pulse-phone.webp"
              data-image="/assets/portfolio/life-pulse-phone.webp"
              data-title="LifeSuite · Pulse"
              aria-label="Enlarge LifeSuite Pulse on a phone"
              ><span class="device-speaker" aria-hidden="true"></span
              ><img
                class="life-phone-image"
                src="/assets/portfolio/previews/life-pulse-phone.webp"
                alt="LifeSuite Pulse timeline on a phone"
                width="390"
                height="844"
                loading="lazy"
            /></a>
          </div>
          <a
            class="text-link life-shopping-film"
            href="/assets/portfolio/lifesuite-shopping.mp4"
            data-film="/assets/portfolio/lifesuite-shopping.mp4"
            data-title="LifeSuite · Shopping lists"
            data-description="Switch shopping lists, see bought items and open purchase history. "
            hidden=""
            >Watch a shopping flow ↗</a
          >
        </div>
      </div>
    </article>

    <article
      class="project-panel"
      id="projectboard"
      data-section="projectboard-case"
      aria-labelledby="projectboard-title"
    >
      <div class="project-info reveal">
        <p class="eyebrow">PROJECT MANAGEMENT</p>
        <h3 id="projectboard-title" class="project-identity identity-projectboard">
          <img
            src="/assets/portfolio/projectboard-mark.svg"
            alt=""
            aria-hidden="true"
            class="identity-mark"
            width="64"
            height="64"
          /><span class="identity-name">ProjectBoard</span>
        </h3>
        <p class="project-purpose">The whole project, clearly organised</p>
        <p class="project-detail">
          Goals, progress, decisions and project records. Built for the way I work with AI.
        </p>
        <a class="text-link" href="#project-plan">Explore a project plan ↓</a>
      </div>
      <figure class="project-visual reveal">
        <div class="laptop-device board-showcase">
          <div class="laptop-display">
            <span class="device-camera" aria-hidden="true"></span
            ><picture
              ><source
                media="(max-width:700px)"
                srcset="/assets/portfolio/previews/projectboard-case-phone.webp" />
              <img
                src="/assets/portfolio/previews/projectboard-case.webp"
                alt="ProjectBoard showing privacy and offline work with progress and task statuses"
                width="1200"
                height="800"
                loading="lazy"
            /></picture>
          </div>
          <div class="laptop-base" aria-hidden="true"></div>
        </div>
      </figure>
    </article>
  </div>
  <div class="more-heading"><h3>And more</h3></div>
  <div class="more-grid">
    <article data-section="rolleo-case" aria-labelledby="rolleo-title">
      <div class="small-info">
        <h3 id="rolleo-title" class="project-identity identity-rolleo">
          <img
            src="/assets/portfolio/rolleo-mark.svg"
            alt=""
            aria-hidden="true"
            class="identity-mark"
            width="64"
            height="64"
          /><span class="identity-name">Rolleo</span>
        </h3>
        <p>Multiplayer 3D racing game</p>
      </div>
      <div class="more-project-card">
        <a
          class="more-preview"
          href="/assets/portfolio/rolleo.mp4"
          data-film="/assets/portfolio/rolleo.mp4"
          data-title="Rolleo gameplay"
          aria-label="Watch Rolleo gameplay"
          ><img
            src="/assets/portfolio/rolleo.png"
            alt="Rolleo race through a mountain landscape"
            loading="lazy" /><span class="card-play" aria-hidden="true"
            ><svg viewBox="0 0 24 24" fill="currentColor">
              <path d="m9 5 11 7-11 7Z"></path></svg></span></a
        ><a class="card-visit" href="https://playrolleo.com" target="_blank" rel="noopener"
          >Play a race <span aria-hidden="true">↗</span></a
        >
      </div>
    </article>
    <article data-section="archive-case" aria-labelledby="archive-title">
      <div class="small-info">
        <h3 id="archive-title" class="project-identity identity-sunny">
          <img
            src="/assets/portfolio/sunny-mark.svg"
            alt=""
            aria-hidden="true"
            class="identity-mark"
            width="64"
            height="64"
          /><span class="identity-name">Sunny Varkey K.</span>
        </h3>
        <p>Author, educator &amp; musician</p>
      </div>
      <div class="more-project-card">
        <a
          class="more-preview"
          href="/assets/portfolio/sunny-laptop.webp"
          data-image="/assets/portfolio/sunny-laptop.webp"
          data-title="Sunny Varkey K. website"
          aria-label="Enlarge Sunny Varkey K. website"
          ><img
            src="/assets/portfolio/previews/sunny-laptop.webp"
            alt="Sunny Varkey K. website featuring his English teaching, writing and video lessons"
            loading="lazy" /></a
        ><a class="card-visit" href="https://sunnyvarkeyk.com" target="_blank" rel="noopener"
          >Visit the website <span aria-hidden="true">↗</span></a
        >
      </div>
    </article>
    <article data-section="renz-case" aria-labelledby="renz-title">
      <div class="small-info">
        <h3 id="renz-title" class="project-identity identity-renz">
          <img
            src="/assets/portfolio/renz-mark.svg"
            alt=""
            aria-hidden="true"
            class="identity-mark"
            width="64"
            height="64"
          /><span class="identity-name">Renz World</span>
        </h3>
        <p>Interactive creator website</p>
      </div>
      <div class="more-project-card">
        <a
          class="more-preview"
          href="/assets/portfolio/renz-tablet.webp"
          data-image="/assets/portfolio/renz-tablet.webp"
          data-title="Renz World website"
          aria-label="Enlarge Renz World website"
          ><img
            src="/assets/portfolio/previews/renz-tablet.webp"
            alt="Renz World personal website with his illustrated portrait and introduction"
            loading="lazy" /></a
        ><a class="card-visit" href="https://renz.world" target="_blank" rel="noopener"
          >Explore Renz World <span aria-hidden="true">↗</span></a
        >
      </div>
    </article>
  </div>
</section>
